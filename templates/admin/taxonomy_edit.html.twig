{% extends 'base.html.twig' %}

{% block title %}{{ titre }}{% endblock %}

{% block body %}
<div class="container text-light my-4">
    <h1 class="h3 mb-3">{{ titre }}</h1>

    {{ form_start(form, {'attr': {'class': 'row g-2 align-items-end mb-4'}}) }}
        <div class="col-12 text-danger small">{{ form_errors(form) }}</div>
        {% set champ = form.children|first %}
        <div class="col-12 col-md-6">
            {{ form_label(champ, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(champ, {'attr': {'class': 'form-control' ~ (champ.vars.valid ? '' : ' is-invalid')}}) }}
            {% for error in champ.vars.errors %}
                <div class="text-danger small">{{ error.message }}</div>
            {% endfor %}
        </div>
        <div class="col-auto">
            {{ form_widget(form.save, {'attr': {'class': 'btn btn-primary'}}) }}
        </div>
    {{ form_end(form) }}

    <a href="{{ retour }}" class="btn btn-outline-light btn-sm">← Retour</a>
</div>
{% endblock %}
