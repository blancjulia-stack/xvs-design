{% extends 'base.html.twig' %}

{% block title %}Administration — Sous-catégories{% endblock %}

{% block body %}
<div class="container text-light my-4">
    <h1 class="h3 mb-3">Gérer les sous-catégories</h1>

    {% include 'partials/flash.html.twig' %}

    <div class="mb-4 d-flex flex-wrap gap-2">
        <a href="{{ path('admin.edit') }}" class="btn btn-outline-light btn-sm">← Administration</a>
        <a href="{{ path('admin.category.show') }}" class="btn btn-outline-light btn-sm">Gérer les catégories</a>
    </div>

    <h2 class="h5">Ajouter une sous-catégorie</h2>
    {{ form_start(form, {'attr': {'class': 'row g-2 align-items-end mb-4'}}) }}
        <div class="col-12 text-danger small">{{ form_errors(form) }}</div>
        <div class="col-12 col-md-6">
            {{ form_label(form.type, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.type, {'attr': {'class': 'form-control' ~ (form.type.vars.valid ? '' : ' is-invalid')}}) }}
            {% for error in form.type.vars.errors %}
                <div class="text-danger small">{{ error.message }}</div>
            {% endfor %}
        </div>
        <div class="col-auto">
            {{ form_widget(form.save, {'attr': {'class': 'btn btn-primary'}}) }}
        </div>
    {{ form_end(form) }}

    <h2 class="h5">Sous-catégories existantes ({{ sousCategories|length }})</h2>
    <table class="table table-dark table-striped align-middle">
        <thead>
            <tr>
                <th>Nom</th>
                <th class="text-center">Images</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for sc in sousCategories %}
            <tr>
                <td>{{ sc.type }}</td>
                <td class="text-center">{{ sc.portfolios|length }}</td>
                <td class="text-end">
                    <a href="{{ path('souscategory.edit', {id: sc.id}) }}" class="btn btn-primary btn-sm">Modifier</a>
                    <form action="{{ path('souscategory.delete', {id: sc.id}) }}" method="post" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-souscategory-' ~ sc.id) }}">
                        <button type="submit" class="btn btn-danger btn-sm"
                                onclick="return confirm('Supprimer la sous-catégorie « {{ sc.type|e('js') }} » ? Elle sera retirée des images qui l\'utilisent (les images sont conservées).');">Supprimer</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="3" class="text-center">Aucune sous-catégorie pour le moment.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
