{% extends 'base.html.twig' %}

{% block title %}Hello AdminController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Hello Julia! ✅</h1>

  
<h2 class="title">Entrez les données a inserer</h2>
    {{form_start(form)}}
    <div class="d-flex">
        {{ form_row(form.nom_image) }}
       {{ form_row(form.image) }}
    </div>
    <div class="d-flex">
        {{ form_row(form.category) }}
        {{ form_row(form.sousCategories) }}
    </div>
    <div class="d-flex">
        {{ form_row(form.mock_up) }}
      
    </div>
    {{ form_end(form) }}
 
<a href={{ path('admin.edit') }} class="btn btn-primary">Retour a l'administration générale</a>



{% endblock %}
